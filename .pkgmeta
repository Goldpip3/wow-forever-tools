# How the BigWigs packager builds a release of the addon.
#
# The packager expects to find a .toc at the top of the checkout, and this
# repository is a website with an addon inside it. package-as names the folder
# players end up with, and move-folders lifts the addon out of its subdirectory
# into that folder. The key there is prefixed with the package name, because it
# is a path inside the staged release rather than inside the repository.
#
# Everything else in the repository is the website, and none of it belongs in
# the zip.

package-as: WoWForeverSync

move-folders:
  WoWForeverSync/addon/WoWForeverSync: WoWForeverSync

ignore:
  - .claude
  - .github
  - dist
  - public
  - scripts
  - src
  - tests
  - INTEGRATION.md
  - README.md
  - dps.html
  - index.html
  - package-lock.json
  - package.json
  - raid.html
  - talents.html
  - tsconfig.json
  - vite.config.ts
